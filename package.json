{
  "name": "profile-photo-analyzer-frontend",
  "private": true,
  "type": "module",
  "description": "Lint and unit tests for the browser code in app/static/js (the page itself has no build step and no runtime dependencies).",
  "scripts": {
    "lint": "eslint app/static/js tests/js eslint.config.js",
    "test": "c8 --reporter=text --reporter=lcovonly --report-dir=coverage-js --include=app/static/js/** node --test \"tests/js/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2"
  }
}
